  "structures": [
    {
      "id": "nao-apenas",
      "regex": "(?i)\\bnão (?:é|foi|era|se trata de) (?:apenas|só|somente) [^.!?\\n]{2,60}[,.;]\\s*(?:é|foi|era)\\b",
      "name": "\"Não é apenas X, é Y\"",
      "fix": "Diga só o Y. Apague a metade que prepara o terreno."
    },
    {
      "id": "nao-so-mas",
      "regex": "(?i)\\bnão (?:só|apenas|somente)\\b[^.!?\\n]{2,80}\\bmas também\\b",
      "name": "\"Não só X, mas também Y\"",
      "fix": "Quebre em duas frases, ou corte a metade mais fraca."
    },
    {
      "id": "nao-e-sobre",
      "regex": "(?i)\\bnão é sobre [^.!?\\n]{2,60}[.!]\\s*é sobre\\b",
      "name": "\"Não é sobre X. É sobre Y.\"",
      "fix": "Comece pelo Y. A inversão é o sinal."
    },
    {
      "id": "pergunta-retorica",
      "regex": "(?im)^[ \\t]*(?:e )?(?:o |a )?[^\\W\\d_]+(?:[ \\t]+[^\\W\\d_]+){0,3}\\?[ \\t]*$",
      "name": "Pergunta retórica curta sozinha na linha (\"O resultado?\")",
      "fix": "Responda na mesma frase em vez de encenar a revelação."
    },
    {
      "id": "melhor-de-tudo",
      "regex": "(?i)\\be o (?:melhor|pior) de tudo\\?",
      "name": "\"E o melhor de tudo?\"",
      "fix": "Diga o que é, direto."
    },
    {
      "id": "aprendi",
      "regex": "(?i)\\b(?:aqui está|eis|veja) o que (?:eu )?aprendi\\b",
      "name": "\"Aqui está o que aprendi\"",
      "fix": "Diga a lição. Pule o anúncio."
    },
    {
      "id": "triade",
      "regex": "(?i)\\b\\w+, \\w+ e \\w+[.!]",
      "name": "Tríade (três itens em série)",
      "fix": "Dois itens ou quatro. Três é o ritmo padrão do modelo."
    },
    {
      "id": "emoji-lista",
      "regex": "(?m)(?:^[ \\t]*[\\U0001F300-\\U0001FAFF\\u2600-\\u27BF][^\\n]*(?:\\n|$)){3,}",
      "name": "Lista com emoji em cada linha",
      "fix": "Tire os emojis da lista. Hífen ou nada."
    },
    {
      "id": "foguete",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF\\U0001F447\\U0001F449]",
      "name": "Emoji de foguete / fogo / lâmpada / brilho / alvo / dedo apontando",
      "fix": "No máximo um emoji, e não um desses."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Parede de hashtags (5+)",
      "fix": "Três hashtags no máximo."
    },
    {
      "id": "como-ia",
      "regex": "(?i)\\bcomo (?:uma )?(?:ia|inteligência artificial|modelo de linguagem)\\b",
      "name": "Autorreferência de modelo",
      "fix": "Apague a frase."
    },
